# انسخ هذا الملف إلى .env وعدّل القيم

NODE_ENV=development
PORT=4000

# رابط قاعدة بيانات PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voya

# مفتاح توقيع JWT — 32 حرفًا على الأقل. ولّد واحدًا بـ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# أصول الواجهة المسموح لها بالاتصال (مفصولة بفواصل)
CORS_ORIGINS=http://localhost:3000

# اجعلها true خلف HTTPS في الإنتاج
COOKIE_SECURE=false

BCRYPT_ROUNDS=12
