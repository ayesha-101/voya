{
  "name": "voya-store",
  "private": true,
  "version": "1.0.0",
  "description": "متجر ڤويا الإلكتروني — واجهة Next.js وواجهة برمجية Express مع PostgreSQL",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "start": "concurrently -n api,web -c cyan,magenta \"npm:start:server\" \"npm:start:client\"",
    "start:server": "npm run start --workspace server",
    "start:client": "npm run start --workspace client",
    "lint": "npm run lint --workspace client && npm run lint --workspace server",
    "db:migrate": "npm run migrate --workspace server",
    "db:seed": "npm run seed --workspace server",
    "db:reset": "npm run reset --workspace server",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
